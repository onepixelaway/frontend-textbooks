{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repair-tasks.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportHash", "tasks"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [2] },
    "reportHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["failureId", "code", "viewport", "target", "allowedActions", "instruction"],
        "properties": {
          "failureId": { "type": "string", "minLength": 1 },
          "code": { "type": "string", "minLength": 1 },
          "viewport": { "type": "string", "minLength": 1 },
          "observedViewports": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["desktop", "print", "mobile", "pdf"] } },
          "target": { "type": "string", "minLength": 1 },
          "sourceBlockIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "sourceContext": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "text"],
              "properties": { "id": { "type": "string" }, "text": { "type": "string" } }
            }
          },
          "planSelectionIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "evidencePaths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "allowedActions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "instruction": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
