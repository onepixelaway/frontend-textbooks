{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "book-plan.schema.json",
  "title": "Model-authored editorial plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "manuscriptHash", "editorial", "theme", "layout", "visuals", "classifications", "exceptions", "aestheticReview"],
  "properties": {
    "version": { "type": "integer", "enum": [3] },
    "manuscriptHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "editorial": {
      "type": "object", "additionalProperties": false,
      "required": ["audience", "genre", "purpose", "tone"],
      "properties": {
        "audience": { "type": "string", "minLength": 1 },
        "genre": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "tone": { "type": "string", "minLength": 1 }
      }
    },
    "theme": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "rationale"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "layout": {
      "type": "object", "additionalProperties": false,
      "required": ["bodyColumns", "chapterOpeners", "coverRoute", "rationale"],
      "properties": {
        "bodyColumns": { "type": "string", "enum": ["text-two", "text-single", "text-three"] },
        "chapterOpeners": { "type": "boolean" },
        "coverRoute": { "type": "string", "enum": ["photo", "minimal"] },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "visuals": {
      "type": "object", "additionalProperties": false,
      "required": ["policy", "cover", "diagrams", "featurePages", "images"],
      "properties": {
        "policy": { "type": "string", "enum": ["selective", "image-led"] },
        "cover": {
          "type": "object", "additionalProperties": false,
          "required": ["sourceBlockIds", "subject", "rationale", "altText", "focalPoint", "generationId"],
          "properties": {
            "sourceBlockIds": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "subject": { "type": "string", "minLength": 12, "maxLength": 320 },
            "rationale": { "type": "string", "minLength": 20, "maxLength": 600 },
            "altText": { "type": "string", "minLength": 20, "maxLength": 320 },
            "focalPoint": {
              "type": "object", "additionalProperties": false,
              "required": ["x", "y"],
              "properties": {
                "x": { "type": "number", "minimum": 0, "maximum": 100 },
                "y": { "type": "number", "minimum": 0, "maximum": 100 }
              }
            },
            "generationId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{15,127}$" }
          }
        },
        "diagrams": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["sourceBlockIds", "grammar", "title", "nodes", "edges", "caption", "takeaway", "rationale"],
            "properties": {
              "sourceBlockIds": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "grammar": { "type": "string", "enum": ["sequence", "comparison", "hierarchy", "anatomy", "taxonomy", "matrix", "system"] },
              "title": { "type": "string", "minLength": 1, "maxLength": 90 },
              "nodes": {
                "type": "array", "minItems": 2, "maxItems": 6,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["id", "label"],
                  "properties": {
                    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
                    "label": { "type": "string", "minLength": 1, "maxLength": 64 },
                    "detail": { "type": "string", "minLength": 1, "maxLength": 120 }
                  }
                }
              },
              "edges": {
                "type": "array", "maxItems": 12,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["from", "to"],
                  "properties": {
                    "from": { "type": "string", "minLength": 1 },
                    "to": { "type": "string", "minLength": 1 },
                    "label": { "type": "string", "minLength": 1, "maxLength": 48 }
                  }
                }
              },
              "caption": { "type": "string", "minLength": 1, "maxLength": 240 },
              "takeaway": { "type": "string", "minLength": 1, "maxLength": 180 },
              "rationale": { "type": "string", "minLength": 1, "maxLength": 600 }
            }
          }
        },
        "featurePages": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "kind", "anchorSourceBlockId", "sourceBlockIds", "eyebrow", "title", "deck", "rationale"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
              "kind": { "type": "string", "enum": ["framework", "scorecard", "numbers"] },
              "anchorSourceBlockId": { "type": "string", "minLength": 1 },
              "sourceBlockIds": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "eyebrow": { "type": "string", "minLength": 1, "maxLength": 64 },
              "title": { "type": "string", "minLength": 1, "maxLength": 90 },
              "deck": { "type": "string", "minLength": 1, "maxLength": 240 },
              "items": {
                "type": "array", "minItems": 3, "maxItems": 6,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["label", "detail"],
                  "properties": {
                    "label": { "type": "string", "minLength": 1, "maxLength": 40 },
                    "detail": { "type": "string", "minLength": 1, "maxLength": 140 }
                  }
                }
              },
              "footer": { "type": "string", "minLength": 1, "maxLength": 120 },
              "sides": {
                "type": "array", "minItems": 2, "maxItems": 2,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["label", "descriptor", "metrics"],
                  "properties": {
                    "label": { "type": "string", "minLength": 1, "maxLength": 48 },
                    "descriptor": { "type": "string", "minLength": 1, "maxLength": 90 },
                    "metrics": {
                      "type": "array", "minItems": 2, "maxItems": 4,
                      "items": {
                        "type": "object", "additionalProperties": false,
                        "required": ["value", "label"],
                        "properties": {
                          "value": { "type": "string", "minLength": 1, "maxLength": 24 },
                          "label": { "type": "string", "minLength": 1, "maxLength": 80 }
                        }
                      }
                    }
                  }
                }
              },
              "verdictLabel": { "type": "string", "minLength": 1, "maxLength": 12 },
              "verdict": { "type": "string", "minLength": 1, "maxLength": 220 },
              "panels": {
                "type": "array", "minItems": 2, "maxItems": 4,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["label", "entries"],
                  "properties": {
                    "label": { "type": "string", "minLength": 1, "maxLength": 64 },
                    "entries": {
                      "type": "array", "minItems": 2, "maxItems": 2,
                      "items": {
                        "type": "object", "additionalProperties": false,
                        "required": ["label", "value", "barPercent"],
                        "properties": {
                          "label": { "type": "string", "minLength": 1, "maxLength": 32 },
                          "value": { "type": "string", "minLength": 1, "maxLength": 24 },
                          "barPercent": { "type": "number", "minimum": 0, "maximum": 100 }
                        }
                      }
                    }
                  }
                }
              },
              "highlight": {
                "type": "object", "additionalProperties": false,
                "required": ["value", "text"],
                "properties": {
                  "value": { "type": "string", "minLength": 1, "maxLength": 24 },
                  "text": { "type": "string", "minLength": 1, "maxLength": 220 }
                }
              },
              "rationale": { "type": "string", "minLength": 1, "maxLength": 600 }
            }
          }
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["scope", "subject", "rationale", "altText"],
            "properties": {
              "scope": { "type": "string", "minLength": 1 },
              "subject": { "type": "string", "minLength": 1 },
              "rationale": { "type": "string", "minLength": 1 },
              "altText": { "type": "string", "minLength": 12 }
            }
          }
        }
      }
    },
    "classifications": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sourceBlockId", "role", "treatment", "rationale"],
        "properties": {
          "sourceBlockId": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "enum": ["narrative", "definition", "process", "comparison", "evidence", "exercise", "summary", "transition"] },
          "treatment": { "type": "string", "enum": ["prose", "callout", "diagram", "table", "checklist", "quote", "image-brief"] },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["rule", "scope", "rationale"],
        "properties": {
          "rule": { "type": "string", "enum": ["allow-flowing-prose", "waive-diagrams", "waive-feature-pages", "waive-part-images", "allow-image-only", "allow-remote-fonts"] },
          "scope": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "aestheticReview": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "criteria"],
      "properties": {
        "required": { "type": "boolean" },
        "criteria": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
