{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "book-config.schema.json",
  "title": "Frontend Textbooks book configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "author", "coverImage"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string" },
    "outputDir": { "type": "string", "minLength": 1 },
    "outputHtml": { "type": "string", "pattern": "^[^/\\\\]+\\.html?$" },
    "coverImage": { "type": "string", "minLength": 1 },
    "coverBandHeight": { "type": "number", "minimum": 2.8, "maximum": 4.4 },
    "requirePartImages": { "type": "boolean" },
    "requireDiagrams": { "type": "boolean" },
    "requireFeaturePages": { "type": "boolean" },
    "chapterOpeners": { "type": "boolean" },
    "chapterClosers": { "type": "object", "additionalProperties": { "type": "string" } },
    "partImages": { "type": "object", "additionalProperties": { "type": "string" } },
    "style": { "type": "string", "minLength": 1 },
    "themeOverrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "browser": { "type": "string", "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$" },
        "page": { "type": "string", "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$" },
        "ink": { "type": "string", "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$" },
        "heading": { "type": "string", "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$" },
        "deck": { "type": "string", "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$" },
        "muted": { "type": "string", "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$" },
        "meta": { "type": "string", "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$" },
        "accent": { "type": "string", "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$" },
        "soft": { "type": "string", "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$" },
        "rule": { "type": "string", "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$" },
        "steel": { "type": "string", "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$" },
        "coverBand": { "type": "string", "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$" },
        "callout": { "type": "string", "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$" }
      }
    },
    "selectedCoverRoute": { "type": "string", "enum": ["photo", "minimal"] },
    "bookType": { "type": "string", "enum": ["textbook", "manual", "field-guide", "business", "editorial", "coffee-table", "workbook", "literary", "plain-reader"] },
    "coverKicker": { "type": "string" },
    "bodyColumns": { "type": "string", "enum": ["text-two", "text-single", "text-three"] },
    "fontMode": { "type": "string", "enum": ["system", "remote"] }
  }
}
