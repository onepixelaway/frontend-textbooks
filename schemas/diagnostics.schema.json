{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "diagnostics.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "counts", "items"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [2] },
    "status": { "type": "string", "enum": ["pass", "fail"] },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["error", "warning", "actionable", "derived"],
      "properties": {
        "error": { "type": "integer", "minimum": 0 },
        "warning": { "type": "integer", "minimum": 0 },
        "actionable": { "type": "integer", "minimum": 0 },
        "derived": { "type": "integer", "minimum": 0 }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "code", "severity", "phase", "actionable", "derived", "viewport", "message"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "code": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["error", "warning"] },
          "phase": { "type": "string", "enum": ["contract", "readiness", "pagination", "structure", "source", "aesthetic", "pdf"] },
          "actionable": { "type": "boolean" },
          "derived": { "type": "boolean" },
          "blockedBy": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "viewport": { "type": "string", "enum": ["desktop", "print", "mobile", "pdf"] },
          "pageId": { "type": "string" },
          "sourceBlockIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "sourceContext": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "text"], "properties": { "id": { "type": "string" }, "text": { "type": "string" } } } },
          "evidencePaths": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "actual": { "type": "object" },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
